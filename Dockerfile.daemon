# Build stage for sovereign-daemon
FROM golang:1.27-alpine AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /bin/sovereign-daemon ./cmd/sovereign-daemon

# Final minimal runtime
FROM alpine:3.20

RUN apk --no-cache add ca-certificates tzdata

COPY --from=builder /bin/sovereign-daemon /usr/local/bin/sovereign-daemon

EXPOSE 8080
VOLUME ["/data"]

ENTRYPOINT ["/usr/local/bin/sovereign-daemon"]
